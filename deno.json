{
  "workspace": [
    "./packages/pangit",
    "./packages/pangit-examples",
    "./packages/pangit-site"
  ],
  "nodeModulesDir": "auto",
  "tasks": {
    "generate": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run=deno codegen/generate.ts",
    "e2e": "deno run --allow-read --allow-write --allow-run codegen/tests/run.ts",
    "dev": "deno task --recursive --filter @mannsion/pangit-site dev",
    "build": "deno task --recursive --filter @mannsion/pangit-site build",
    "start": "deno task --recursive --filter @mannsion/pangit-site start",
    "check": "deno check codegen && deno task --recursive --filter @mannsion/* check",
    "test": "deno test --allow-env=NODE_DISABLE_COLORS --allow-read --allow-write --allow-run=deno codegen && deno task --recursive --filter @mannsion/* test",
    "lint": "deno lint codegen && deno task --recursive --filter @mannsion/* lint",
    "fmt": "deno fmt"
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "codegen/specs/raw",
      "codegen/specs/normalized",
      "packages/pangit-site/app/documentation/generated",
      "packages/pangit/src/generated/**/tests/**",
      "packages/pangit/docs/test-results",
      "packages/pangit-site/public",
      "packages/pangit-site/.react-router",
      "packages/pangit-site/build"
    ]
  },
  "exclude": [
    "node_modules",
    "**/.deno",
    "packages/pangit-site/build",
    "packages/pangit-site/.react-router"
  ],
  "imports": {
    "@std/fmt": "jsr:@std/fmt@1.0.10",
    "@std/yaml": "jsr:@std/yaml@1.0.10",
    "openapi-types": "npm:openapi-types@12.1.3",
    "swagger2openapi": "npm:swagger2openapi@7.0.8",
    "turndown": "npm:turndown@7.2.4",
    "turndown-plugin-gfm": "npm:turndown-plugin-gfm@1.0.2",
    "@mannsion/pangit": "jsr:@mannsion/pangit@^0.1.0",
    "@mannsion/pangit-site/config": "jsr:@mannsion/pangit-site@^0.1.0/config",
    "@mannsion/pangit-site/documentation": "jsr:@mannsion/pangit-site@^0.1.0/documentation",
    "@mannsion/pangit-site/urls": "jsr:@mannsion/pangit-site@^0.1.0/urls"
  },
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
