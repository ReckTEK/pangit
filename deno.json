{
  "tasks": {
    "generate": "deno run --allow-read=src/generated --allow-write=src/generated --allow-run=deno codegen/generate.ts",
    "e2e": "deno run --allow-read=codegen/specs/raw/manifest.json,codegen/tests/maps,src/generated --allow-write=src/generated --allow-run codegen/tests/run.ts",
    "check": "deno check src codegen",
    "fmt": "deno fmt",
    "lint": "deno lint src codegen",
    "test": "deno test --allow-env=NODE_DISABLE_COLORS --allow-read=. --allow-write --allow-run=deno codegen src/*_test.ts"
  },
  "imports": {
    "@std/fmt": "jsr:@std/fmt@1.0.10",
    "@std/yaml": "jsr:@std/yaml@1.0.10",
    "openapi-types": "npm:openapi-types@12.1.3",
    "swagger2openapi": "npm:swagger2openapi@7.0.8",
    "turndown": "npm:turndown@7.2.4",
    "turndown-plugin-gfm": "npm:turndown-plugin-gfm@1.0.2"
  },
  "fmt": {
    "exclude": [
      "codegen/specs/normalized/**",
      "codegen/specs/raw/**"
    ],
    "lineWidth": 100
  }
}
