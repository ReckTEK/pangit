+    # Read a generation and value atomically. The generation survives invalidation
+    # and changes to a fresh token, so an older computation cannot repopulate it.
+    FETCH_VALUE = <<~LUA.freeze
+      local generation = redis.call('HGET', KEYS[1], '__generation__')
+      if not generation then
+        generation = ARGV[2]
+        redis.call('HSET', KEYS[1], '__generation__', generation)
+        redis.call('EXPIRE', KEYS[1], ARGV[3])
+      end
+      return {generation, redis.call('HGET', KEYS[1], ARGV[1])}
+    LUA
+
+    STORE_VALUE = <<~LUA.freeze
+      if redis.call('HGET', KEYS[1], '__generation__') == ARGV[1] then
+        return redis.call('HSET', KEYS[1], ARGV[2], ARGV[3])
+      end
+      return 0
+    LUA
+
+    INVALIDATE = <<~LUA.freeze
+      redis.call('DEL', KEYS[1])
+      redis.call('HSET', KEYS[1], '__generation__', ARGV[1])
+      redis.call('EXPIRE', KEYS[1], ARGV[2])
+      return 1
+    LUA
