{
  "schemaVersion": 1,
  "gitHost": "gitea",
  "version": "1.26.4",
  "containerImage": "docker.gitea.com/gitea:1.26.4",
  "service": {
    "name": "gitea",
    "apiUrl": "http://gitea:3000/api/v1",
    "localApiUrl": "http://127.0.0.1:3000/api/v1",
    "environment": {
      "GITEA__actions__ENABLED": "true",
      "GITEA__database__DB_TYPE": "sqlite3",
      "GITEA__database__PATH": "/data/gitea/gitea.db",
      "GITEA__mailer__ENABLED": "false",
      "GITEA__security__INSTALL_LOCK": "true",
      "GITEA__server__DOMAIN": "gitea",
      "GITEA__server__ROOT_URL": "http://gitea:3000/",
      "GITEA__server__SSH_DOMAIN": "gitea",
      "GITEA__server__SSH_PORT": "22",
      "GITEA__service__DISABLE_REGISTRATION": "true",
      "GITEA__security__DISABLE_GIT_HOOKS": "false",
      "GITEA__repository__ENABLE_PUSH_CREATE_USER": "true",
      "GITEA__repository__DEFAULT_BRANCH": "main",
      "GITEA__migrations__ALLOW_LOCALNETWORKS": "true",
      "GITEA__webhook__ALLOWED_HOST_LIST": "private",
      "USER_UID": "1000",
      "USER_GID": "1000",
      "GITEA__git__HOME_PATH": "/data/git"
    },
    "tmpfs": [
      "/data:exec,mode=0750,uid=1000,gid=1000"
    ],
    "uid": "1000",
    "gid": "1000",
    "healthcheck": "test -f /sandbox-auth/ready && wget -qO- --header=\"Authorization: token $$(cat /sandbox-auth/api-token)\" http://127.0.0.1:3000/api/v1/user >/dev/null",
    "bootstrapFile": "bootstrap.sh"
  },
  "runner": {
    "name": "e2e",
    "image": "denoland/deno:2.9.5",
    "workspace": "/workspace",
    "results": "/results",
    "credentials": "/sandbox-auth",
    "timeoutMs": 20000,
    "networkHosts": [
      "webhook-journal:8080"
    ]
  },
  "credentials": {
    "username": "sandbox",
    "password": "gitea-sandbox-password",
    "email": "sandbox@example.invalid",
    "tokenFile": "api-token",
    "authorizationHeader": "authorization",
    "tokenPrefix": "token "
  },
  "services": {
    "webhook-journal": {
      "image": "denoland/deno:2.9.5",
      "init": true,
      "stop_grace_period": "10s",
      "user": "1000:1000",
      "working_dir": "/fixture",
      "entrypoint": [
        "deno"
      ],
      "command": [
        "run",
        "--no-config",
        "--allow-net=0.0.0.0:8080",
        "/fixture/webhook-journal.ts"
      ],
      "volumes": [
        "./webhook-journal.ts:/fixture/webhook-journal.ts:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "deno eval 'const r=await fetch(\"http://127.0.0.1:8080/health\");if(!r.ok)Deno.exit(1)'"
        ],
        "interval": "1s",
        "timeout": "2s",
        "retries": 30
      },
      "restart": "no"
    },
    "actions": {
      "user": "1000:1000",
      "working_dir": "/data",
      "tmpfs": [
        "/data:exec,mode=0750,uid=1000,gid=1000"
      ],
      "entrypoint": [
        "/bin/sh",
        "-ec"
      ],
      "command": [
        "gitea-runner register --no-interactive --config /config.yaml --instance http://gitea:3000 --token \"$$(cat /sandbox-auth/runner-token)\" --name e2e-executor --labels sandbox:host && exec gitea-runner daemon --config /config.yaml"
      ],
      "volumes": [
        "./.auth:/sandbox-auth:ro",
        "./actions-config.yaml:/config.yaml:ro",
        "./upload-artifact.sh:/fixtures/upload-artifact.sh:ro"
      ],
      "depends_on": {
        "gitea": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:9101/readyz >/dev/null"
        ],
        "interval": "1s",
        "timeout": "2s",
        "retries": 60
      },
      "restart": "no",
      "stop_grace_period": "10s",
      "build": {
        "context": ".",
        "dockerfile": "actions.Dockerfile"
      }
    }
  },
  "suites": {
    "generatedRawRestClientTest": {
      "testFile": "tests/e2e/generated/raw-rest-client-tests/gitea/1.26.4/generated-raw-rest-client-e2e_test.ts",
      "manifestFile": "tests/e2e/generated/raw-rest-client-tests/gitea/1.26.4/generated-test-manifest.json",
      "clientImplementation": "packages/pangit/src/generated-rest-clients/gitea/1.26.4/GiteaRestClient.ts"
    },
    "handWrittenFluentApiTest": {
      "testFile": "tests/e2e/hand-written/git-host-adapter-tests/gitea/gitea-fluent-api-e2e_test.ts"
    }
  }
}
