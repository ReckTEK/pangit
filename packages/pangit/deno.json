{
  "name": "@mannsion/pangit",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./api": "./src/fluent-client/mod.ts",
    "./providers/azure-devops/latest": "./src/generated-rest-clients/azure-devops/latest/mod.ts",
    "./providers/bitbucket/latest": "./src/generated-rest-clients/bitbucket/latest/mod.ts",
    "./providers/codeberg/latest": "./src/generated-rest-clients/codeberg/latest/mod.ts",
    "./providers/gitea/1.26.4": "./src/generated-rest-clients/gitea/1.26.4/mod.ts",
    "./providers/gitea/1.27.2": "./src/generated-rest-clients/gitea/1.27.2/mod.ts",
    "./providers/github/latest": "./src/generated-rest-clients/github/latest/mod.ts",
    "./providers/gitlab/18.11.11": "./src/generated-rest-clients/gitlab/18.11.11/mod.ts",
    "./providers/gitlab/19.3.1": "./src/generated-rest-clients/gitlab/19.3.1/mod.ts",
    "./fluent/gitea": "./src/fluent-providers/gitea/mod.ts",
    "./fluent/gitlab": "./src/fluent-providers/gitlab/mod.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "docs/images/pangit-banner.png",
      "THIRD_PARTY_NOTICES.md",
      "src"
    ]
  },
  "tasks": {
    "build": "deno check src",
    "check": "deno check src",
    "fmt": "deno fmt src",
    "lint": "deno lint src",
    "test": "deno test --permit-no-files src"
  },
  "fmt": {
    "lineWidth": 100
  }
}
