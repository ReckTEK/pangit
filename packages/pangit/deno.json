{
  "name": "@mannsion/pangit",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./api": "./src/api/mod.ts",
    "./providers/azure-devops/latest": "./src/providers/azure-devops/latest/mod.ts",
    "./providers/bitbucket/latest": "./src/providers/bitbucket/latest/mod.ts",
    "./providers/codeberg/latest": "./src/providers/codeberg/latest/mod.ts",
    "./providers/gitea/1.26.4": "./src/providers/gitea/1.26.4/mod.ts",
    "./providers/gitea/1.27.2": "./src/providers/gitea/1.27.2/mod.ts",
    "./providers/github/latest": "./src/providers/github/latest/mod.ts",
    "./providers/gitlab/18.11.11": "./src/providers/gitlab/18.11.11/mod.ts",
    "./providers/gitlab/19.3.1": "./src/providers/gitlab/19.3.1/mod.ts"
  },
  "publish": {
    "include": [
      "README.md",
      "src"
    ]
  },
  "tasks": {
    "build": "deno check src",
    "check": "deno check src",
    "fmt": "deno fmt src",
    "lint": "deno lint src",
    "test": "deno test --permit-no-files src"
  },
  "fmt": {
    "lineWidth": 100
  }
}
