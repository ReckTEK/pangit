{
  "name": "@mannsion/pangit-examples",
  "version": "0.1.0",
  "exports": "./main.ts",
  "tasks": {
    "start": "docker compose up",
    "stop": "docker compose down",
    "site": "deno run --allow-run=docker,deno sandbox/launch.ts site-dev",
    "cli": "deno run --allow-run=docker,deno sandbox/launch.ts cli",
    "example": "deno run --env-file=.env --allow-env --allow-net main.ts",
    "check": "deno check main.ts oauth cli sandbox",
    "test": "deno test --permit-no-files",
    "lint": "deno lint main.ts oauth cli sandbox"
  }
}
